# Copie para apps/api/.env e ajuste. NUNCA commite o .env.
# Se trocar POSTGRES_PORT no .env da raiz (ex.: 5433), troque a porta aqui também.
DATABASE_URL=postgresql+psycopg://treinos:treinos@localhost:5432/treinos
# Em produção use um valor longo e aleatório (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=dev-secret-troque
# Origens permitidas no CORS (JSON). "*" libera tudo; bom para desenvolvimento.
CORS_ORIGINS=["*"]
